AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Signups

# Hack Club Auth app: https://auth.hackclub.com/developer/apps
# Register this redirect URI exactly:
# https://fjording.hackclub.com/admin/auth/callback
HACKCLUB_AUTH_CLIENT_ID=
HACKCLUB_AUTH_CLIENT_SECRET=

# Long random string. Signs the admin session cookie.
ADMIN_SESSION_SECRET=

# Comma-separated allowlist. Defaults to johnny@hackclub.com only.
# The public RSVP box starts Hack Club Auth only for that exact address.
# /hackathon is locked to this same signed-in admin session. Signed-out
# visitors and anyone not on the allowlist get a 404. Sign in again after
# deploy so the session cookie is also set for /hackathon.
ADMIN_EMAILS=johnny@hackclub.com
