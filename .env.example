AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Signups

# Hack Club Auth app: https://auth.hackclub.com/developer/apps
# Register this redirect URI exactly:
# https://fjording.hackclub.com/admin/auth/callback
HACKCLUB_AUTH_CLIENT_ID=
HACKCLUB_AUTH_CLIENT_SECRET=

# Long random string. Signs the admin session cookie.
ADMIN_SESSION_SECRET=

# Comma-separated owner allowlist. Defaults to johnny@hackclub.com only.
# Owners manage reviewers and see /admin. Reviewers added on /admin/reviewers
# sign in with the same Hack Club Auth flow and can open /reviews for the
# stages they were given. Everyone else gets a 404. The session cookie is set
# on /admin, /hackathon, and /reviews. Sign in again after deploy.
ADMIN_EMAILS=johnny@hackclub.com

# Hackatime OAuth app. Register this redirect URI exactly:
# https://fjording.hackclub.com/auth/hackatime/callback
# Leave both blank and the submit page says Hackatime is not connected yet.
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=

# Postgres from Orchard. Submissions, reviews, checks, and the Airtable outbox live here.
DATABASE_URL=

# Optional. Sync runs only after HQ confirmation is stored in Postgres.
# Uses AIRTABLE_TOKEN. Must not be the sign-ups base (AIRTABLE_BASE_ID) or the Unified base.
# The table must already exist. This app does not create Airtable tables.
NORTHERN_AIRTABLE_BASE_ID=
NORTHERN_AIRTABLE_TABLE=

# Optional. Review checks use the public GitHub API without it until rate limited.
GITHUB_TOKEN=

# Screenshot uploads. The adapter rejects bodies above this.
BODY_SIZE_LIMIT=8M
